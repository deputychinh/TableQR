# Copy to .env; never commit .env. Every key the app reads is listed here.
TQR_DATABASE_URL=postgresql://tableqr:tableqr@127.0.0.1:55432/tableqr
TQR_LOG_LEVEL=info
# HMAC secret for session cookies and table tokens; at least 32 random characters in production.
TQR_SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Origins accepted by the Origin check on non-GET requests (comma separated); the web app reaches the API on its own origin via /api.
TQR_WEB_ORIGINS=http://localhost:5310,http://127.0.0.1:5310,http://localhost:4310,http://127.0.0.1:4310
# Port the API listens on (127.0.0.1); the web dev/preview proxy reads TQR_API_PORT.
PORT=3310
TQR_API_PORT=3310
