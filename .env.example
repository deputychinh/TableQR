# Copy to .env; never commit .env. Every key the app reads is listed here.
TQR_DATABASE_URL=postgresql://tableqr:tableqr@127.0.0.1:55432/tableqr_dev
TQR_LOG_LEVEL=info
# HMAC secret for session cookies and table tokens; at least 32 random characters in production.
TQR_SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Origins accepted by the Origin check on non-GET requests (comma separated); the web app reaches the API on its own origin via /api.
TQR_WEB_ORIGINS=http://localhost:5310,http://127.0.0.1:5310,http://localhost:4310,http://127.0.0.1:4310
# Sign-up and sign-in requests allowed per client address per minute (in memory, per API process).
TQR_AUTH_RATE_LIMIT_PER_MINUTE=20
# Open live (SSE) streams allowed per staff member and per restaurant, per API process.
TQR_STREAMS_PER_USER=10
TQR_STREAMS_PER_RESTAURANT=300
# Live streams shared by the guest phones of one table session (order status + bill per phone).
TQR_STREAMS_PER_GUEST_SESSION=30
# SSE heartbeat in ms; each heartbeat also re-checks the stream's session.
TQR_SSE_HEARTBEAT_MS=15000
# Port the API listens on (127.0.0.1); the web dev/preview proxy reads TQR_API_PORT.
PORT=3310
TQR_API_PORT=3310
