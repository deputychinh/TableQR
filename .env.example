# Copy to .env; never commit .env. Every key the app reads is listed here.
TQR_DATABASE_URL=postgresql://tableqr:tableqr@127.0.0.1:55432/tableqr
TQR_LOG_LEVEL=info
# HMAC secret for session cookies and table tokens; at least 32 random characters in production.
TQR_SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Origins allowed to call the API (comma separated).
TQR_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
